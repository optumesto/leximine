{
	"schemaVersion": 1,
	"id": "leximine",
	"version": "${version}",
	"name": "Leximine",
	"description": "Items you pick up are held in limbo until you say their name in the language you are learning. Pronunciation is checked by a local faster-whisper backend.",
	"authors": [
		"Mason"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.mettle.leximine.Leximine"
		],
		"client": [
			"dev.mettle.leximine.client.LeximineClient"
		]
	},
	"mixins": [
		"leximine.mixins.json",
		{
			"config": "leximine.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~1.20.4",
		"java": ">=17",
		"fabric-api": "*"
	}
}
